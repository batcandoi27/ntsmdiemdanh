rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && getUser().role == 'admin';
    }

    function isPrincipal() {
      return isSignedIn() && getUser().role == 'principal';
    }

    function canViewAll() {
      return isAdmin() || isPrincipal();
    }

    function canViewClass(classId) {
      return canViewAll() || classId in getUser().assignedClassIds;
    }

    function canEditAttendance(classId) {
      let user = getUser();
      return isSignedIn()
        && user.permissions.canEditAttendance == true
        && (user.permissions.canViewAllClasses == true || classId in user.assignedClassIds);
    }

    // ============================================
    // Settings (Admin only write)
    // ============================================
    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============================================
    // Users (Admin/Principal manage)
    // ============================================
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isPrincipal();
      allow update: if isAdmin() || isPrincipal() || request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ============================================
    // API Keys (Admin only)
    // ============================================
    match /apiKeys/{key} {
      allow read, write: if isAdmin();
    }

    // ============================================
    // Year-scoped data (V1 / V2 compatibility)
    // ============================================
    match /years/{year} {
      match /classes/{classId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isPrincipal();
      }
      
      // ... (other rules)
    }

    // ============================================
    // System Config (Feature Flags)
    // ============================================
    match /sys_config/{doc} {
      // Cho phép mọi người (kể cả chưa login) đọc để app khởi tạo UI
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // School-scoped data (V3 architecture)
    // ============================================
    match /schools/{schoolId}/years/{year} {
      match /classes/{classId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isPrincipal();
      }

      // Default wildcard (chỉ áp dụng cho các subcollections chưa được định nghĩa bên dưới)
      // Trong Firebase Console, nên đặt wildcard ở cuối cùng hoặc không dùng để tránh overlap error.
      // Vì đã có rule rõ ràng cho students, timetables, etc. ta không cần wildcard này.

      // Students
      match /students/{studentId} {
        allow read: if isSignedIn();
        allow create: if isAdmin() || isPrincipal();
        allow update: if isAdmin() || isPrincipal()
          || (getUser().role == 'teacher' && resource.data.classId in getUser().assignedClassIds);
        allow delete: if isAdmin();
      }

      // Timetables
      match /timetables/{timetableId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isPrincipal();
      }

      // Attendance records (exception-only)
      match /attendance/{date}/records/{recordId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && canEditAttendance(request.resource.data.classId);
        allow update: if isSignedIn() && canEditAttendance(resource.data.classId);
        allow delete: if isAdmin();
      }

      // Columns (custom columns system)
      match /columns/{columnId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isPrincipal()
          || (getUser().role == 'teacher' && resource.data.classId in getUser().assignedClassIds);
      }

      // Column Data
      match /columnData/{columnId}/records/{recordKey} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      // Report Presets
      match /reportPresets/{presetId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
  }
}
